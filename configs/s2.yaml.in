    sha256: 7e1fd8dedfb3598ca2593729c76285462fda12bb88e3b2bfcf8011304feb5c79
  manifest:
    path: '{{S2_MANIFEST}}'
    sha256: bbe451927543a389c7f4e749cde1f728a139709e499b13debcab3c52ce3fb60e
